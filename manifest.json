{
  "manifest_version": 3,
  "name": "Knexio 阅读伴侣",
  "version": "1.0.0",
  "description": "内置AI翻译+摘要，安装即用。如需更强大AI功能可自行配置API Key，隐私优先不偷数据。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Knexio 阅读伴侣",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://api.deepseek.com/*",
    "https://knexio.xyz/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
